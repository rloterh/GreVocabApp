{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lexicon",
  "version": "1.1.0",
  "identifier": "com.lexicon.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lexicon",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Daily vocabulary practice",
    "longDescription": "Lexicon is a premium daily vocabulary practice app with spaced-repetition flashcards, quizzes, sentence writing with AI verification, and progress tracking."
  }
}
